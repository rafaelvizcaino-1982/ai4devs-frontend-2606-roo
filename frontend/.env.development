REACT_APP_API_URL=http://localhost:3010
# Dev needs 'unsafe-inline' styles (style-loader injects <style> tags) and the HMR websocket.
REACT_APP_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://localhost:3010 ws://localhost:3000; object-src 'none'; base-uri 'self'; form-action 'self'
