# Set REACT_APP_API_URL to the production API origin and keep connect-src in sync with it.
REACT_APP_API_URL=http://localhost:3010
REACT_APP_CSP=default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://localhost:3010; object-src 'none'; base-uri 'self'; form-action 'self'
# Emit the webpack runtime as a file instead of an inline <script>, so script-src 'self' needs no hash/unsafe-inline.
INLINE_RUNTIME_CHUNK=false
